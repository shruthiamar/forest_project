# Copy to .env and fill in. Never commit .env (it is in .gitignore).
LLM_PROVIDER=anthropic          # anthropic | openai | fake
ANTHROPIC_API_KEY=sk-ant-...    # needed when LLM_PROVIDER=anthropic
# OPENAI_API_KEY=sk-...         # needed when LLM_PROVIDER=openai
# LLM_MODEL=claude-haiku-5-5    # optional; defaults per provider

DATA_PATH=data/forest_carbon_long.csv
MAX_CONTEXT_TOKENS=1500
MAX_OUTPUT_TOKENS=400
TOP_K=25
REQUEST_TIMEOUT_S=30

# Copy current prices (USD per million tokens) from your provider's pricing page
COST_PER_MTOK_INPUT=0
COST_PER_MTOK_OUTPUT=0
